SMARTSCAN_ENV=development
SMARTSCAN_DATABASE_URL=sqlite:///./smartscan.db
SMARTSCAN_AUTO_MIGRATE=true
SMARTSCAN_STORAGE_ROOT=./data
SMARTSCAN_SECRET_KEY=replace-with-at-least-32-random-characters
SMARTSCAN_PHONE_PEPPER=replace-with-an-independent-random-pepper
SMARTSCAN_SUPERADMIN_PASSWORD=replace-before-first-start
SMARTSCAN_CORS_ORIGINS=["http://localhost:8080","http://localhost:8081"]
SMARTSCAN_DEV_SMS_CODE=246810
SMARTSCAN_WECOM_MODE=disabled
SMARTSCAN_WECOM_CORP_ID=
SMARTSCAN_WECOM_AGENT_ID=
SMARTSCAN_WECOM_SECRET=
SMARTSCAN_WECOM_TIMEOUT_SECONDS=5
SMARTSCAN_MAX_UPLOAD_BYTES=26214400
SMARTSCAN_UPLOAD_CHUNK_BYTES=4194304
SMARTSCAN_UPLOAD_EXPIRY_HOURS=24
SMARTSCAN_VISION_DOCUMENT_MIN_AREA_RATIO=0.2
SMARTSCAN_VISION_MAX_DETECTION_DIMENSION=1600
POSTGRES_PASSWORD=replace-with-a-strong-database-password

