SMARTSCAN_ENV=development
SMARTSCAN_DATABASE_URL=sqlite:///./smartscan.db
SMARTSCAN_AUTO_MIGRATE=true
SMARTSCAN_STORAGE_ROOT=./data
SMARTSCAN_INTERNAL_FILE_SEND_PREFIX=
SMARTSCAN_SECRET_KEY=replace-with-at-least-32-random-characters
SMARTSCAN_PHONE_PEPPER=replace-with-an-independent-random-pepper
SMARTSCAN_PHONE_HMAC_ACTIVE_KEY_ID=legacy-v1
SMARTSCAN_PHONE_HMAC_PEPPERS={}
SMARTSCAN_PHONE_ENCRYPTION_ACTIVE_KEY_ID=phone-v1
SMARTSCAN_PHONE_ENCRYPTION_KEYS={}
SMARTSCAN_SUPERADMIN_PASSWORD=replace-before-first-start
SMARTSCAN_CORS_ORIGINS=["http://localhost:8080","http://localhost:8081"]
SMARTSCAN_DEV_SMS_CODE=246810
SMARTSCAN_SMS_MODE=disabled
SMARTSCAN_WECOM_MODE=disabled
SMARTSCAN_WECOM_CORP_ID=
SMARTSCAN_WECOM_AGENT_ID=
SMARTSCAN_WECOM_SECRET=
SMARTSCAN_WECOM_REDIRECT_URI=
SMARTSCAN_WECOM_TIMEOUT_SECONDS=5
SMARTSCAN_ACCESS_TOKEN_MINUTES=15
SMARTSCAN_REFRESH_TOKEN_DAYS=30
SMARTSCAN_ACCOUNT_DELETION_GRACE_DAYS=7
SMARTSCAN_PHONE_REUSE_QUARANTINE_DAYS=30
SMARTSCAN_MAX_UPLOAD_BYTES=26214400
SMARTSCAN_UPLOAD_CHUNK_BYTES=4194304
SMARTSCAN_UPLOAD_EXPIRY_HOURS=24
SMARTSCAN_JOB_LEASE_SECONDS=300
SMARTSCAN_JOB_RETRY_BASE_SECONDS=5
SMARTSCAN_JOB_MAX_ATTEMPTS=3
SMARTSCAN_VISION_DOCUMENT_MIN_AREA_RATIO=0.2
SMARTSCAN_VISION_MAX_DETECTION_DIMENSION=1600
SMARTSCAN_OCR_ENABLED=false
SMARTSCAN_OCR_MODEL_ROOT=/opt/smartscan/models/ocr
SMARTSCAN_OCR_PACKAGE_VERSION=3.7.0
SMARTSCAN_OCR_ENGINE_VERSION=3.3.1
SMARTSCAN_OCR_MODEL_VERSION=PP-OCRv6-small-v1
SMARTSCAN_OCR_CPU_THREADS=4
SMARTSCAN_OCR_MIN_CONFIDENCE=0.55
SMARTSCAN_OCR_TITLE_MIN_CONFIDENCE=0.70
SMARTSCAN_OCR_ORIENTATION_MARGIN=0.04
# 可选视觉 AI Provider 的 JSON 数组；默认空数组表示全部关闭。
# 密钥只通过各 Provider 的 api_key_env 引用，不得直接写入此配置。
# 每项还可设置 timeout_seconds、max_retries、concurrency_limit、requests_per_minute、
# daily_cost_limit_usd、max_cost_per_request_usd、circuit_failure_threshold 和
# circuit_open_seconds；费用字段必须按供应商最坏计价保守配置。
SMARTSCAN_AI_PROVIDERS=[]
POSTGRES_PASSWORD=replace-with-a-strong-database-password

