SMARTSCAN_DEPLOYMENT_TIER=uat
SMARTSCAN_UAT_ISOLATION_ACK=uat-only-no-production-data
COMPOSE_PROJECT_NAME=smartscan-uat
SMARTSCAN_UAT_RUNTIME_ENV_FILE=/etc/smartscan/uat/runtime.env
SMARTSCAN_UAT_ALLOCATION_FILE=/etc/smartscan/uat/shared-host-allocation.json
SMARTSCAN_UAT_PREFLIGHT_EVIDENCE_SHA256=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
SMARTSCAN_UAT_BIND_ADDRESS=127.0.0.1
SMARTSCAN_UAT_HTTP_PORT=18081
SMARTSCAN_UAT_DATA_SUBNET=172.30.10.0/24
SMARTSCAN_UAT_DATA_GATEWAY=172.30.10.1
SMARTSCAN_UAT_EDGE_SUBNET=172.30.11.0/24
SMARTSCAN_UAT_EDGE_GATEWAY=172.30.11.1
SMARTSCAN_UAT_EGRESS_SUBNET=172.30.12.0/24
SMARTSCAN_UAT_EGRESS_GATEWAY=172.30.12.1
SMARTSCAN_UAT_POSTGRES_ROOT=/mnt/data/smartscan/uat/postgres
SMARTSCAN_UAT_WAL_ROOT=/mnt/data/smartscan/uat/wal
SMARTSCAN_UAT_DATA_ROOT=/mnt/data/smartscan/uat/data
SMARTSCAN_UAT_MODEL_ROOT=/mnt/data/smartscan/uat/models/ocr
SMARTSCAN_UAT_POSTGRES_IMAGE=postgres@sha256:1111111111111111111111111111111111111111111111111111111111111111
SMARTSCAN_UAT_API_IMAGE=ghcr.io/j4meshub/smartscan-api@sha256:2222222222222222222222222222222222222222222222222222222222222222
SMARTSCAN_UAT_WORKER_IMAGE=ghcr.io/j4meshub/smartscan-worker@sha256:3333333333333333333333333333333333333333333333333333333333333333
SMARTSCAN_UAT_AI_GATEWAY_IMAGE=ghcr.io/j4meshub/smartscan-ai-gateway@sha256:4444444444444444444444444444444444444444444444444444444444444444
SMARTSCAN_UAT_WEB_IMAGE=ghcr.io/j4meshub/smartscan-web@sha256:5555555555555555555555555555555555555555555555555555555555555555
SMARTSCAN_UAT_OPS_IMAGE=ghcr.io/j4meshub/smartscan-ops@sha256:6666666666666666666666666666666666666666666666666666666666666666
POSTGRES_PASSWORD=ci-only-uat-database-password
