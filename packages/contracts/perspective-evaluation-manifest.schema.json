{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartscan.local/schemas/perspective-evaluation-manifest.schema.json",
  "title": "SmartScan 文档透视评估清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "authorization", "samples"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "deidentified", "license", "consent_reference", "purpose"],
      "properties": {
        "approved": {"const": true},
        "deidentified": {"const": true},
        "license": {"type": "string", "minLength": 1},
        "consent_reference": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "category": {"type": "string"},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document_present"],
            "properties": {
              "document_present": {"type": "boolean"},
              "corners_normalized": {
                "type": ["array", "null"],
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {"type": "number", "minimum": 0, "maximum": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
