{
  "contract": "SmartScan 可选视觉 AI 固定评估输入",
  "manifest": {
    "$defs": {
      "Authorization": {
        "additionalProperties": false,
        "properties": {
          "approved": {
            "const": true,
            "title": "Approved",
            "type": "boolean"
          },
          "consent_reference": {
            "minLength": 1,
            "title": "Consent Reference",
            "type": "string"
          },
          "deidentified": {
            "const": true,
            "title": "Deidentified",
            "type": "boolean"
          },
          "license": {
            "minLength": 1,
            "title": "License",
            "type": "string"
          },
          "purpose": {
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": [
          "approved",
          "deidentified",
          "license",
          "consent_reference",
          "purpose"
        ],
        "title": "Authorization",
        "type": "object"
      },
      "CoreFlowEvidence": {
        "additionalProperties": false,
        "properties": {
          "completion_rate": {
            "maximum": 1,
            "minimum": 0,
            "title": "Completion Rate",
            "type": "number"
          },
          "evidence_reference": {
            "minLength": 1,
            "title": "Evidence Reference",
            "type": "string"
          },
          "external_ai_disabled": {
            "const": true,
            "title": "External Ai Disabled",
            "type": "boolean"
          },
          "reviewed": {
            "const": true,
            "title": "Reviewed",
            "type": "boolean"
          },
          "sample_count": {
            "minimum": 1,
            "title": "Sample Count",
            "type": "integer"
          }
        },
        "required": [
          "external_ai_disabled",
          "sample_count",
          "completion_rate",
          "evidence_reference",
          "reviewed"
        ],
        "title": "CoreFlowEvidence",
        "type": "object"
      },
      "EvaluationSample": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "minLength": 1,
            "title": "Category",
            "type": "string"
          },
          "expected": {
            "additionalProperties": true,
            "title": "Expected",
            "type": "object"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "language": {
            "enum": [
              "zh-CN",
              "en",
              "mixed"
            ],
            "title": "Language",
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "title": "Path",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "source_group": {
            "title": "Source Group",
            "type": "string"
          },
          "split": {
            "enum": [
              "train",
              "validation",
              "test"
            ],
            "title": "Split",
            "type": "string"
          },
          "task": {
            "additionalProperties": true,
            "title": "Task",
            "type": "object"
          }
        },
        "required": [
          "id",
          "source_group",
          "split",
          "category",
          "language",
          "path",
          "sha256",
          "task",
          "expected"
        ],
        "title": "EvaluationSample",
        "type": "object"
      },
      "SplitPolicy": {
        "additionalProperties": false,
        "properties": {
          "group_by": {
            "const": "source_group",
            "title": "Group By",
            "type": "string"
          },
          "review_reference": {
            "minLength": 1,
            "title": "Review Reference",
            "type": "string"
          },
          "reviewed": {
            "const": true,
            "title": "Reviewed",
            "type": "boolean"
          }
        },
        "required": [
          "group_by",
          "reviewed",
          "review_reference"
        ],
        "title": "SplitPolicy",
        "type": "object"
      },
      "Thresholds": {
        "additionalProperties": false,
        "properties": {
          "approval_reference": {
            "minLength": 1,
            "title": "Approval Reference",
            "type": "string"
          },
          "approved_by": {
            "minLength": 1,
            "title": "Approved By",
            "type": "string"
          },
          "maximum_average_cost_microusd": {
            "minimum": 0,
            "title": "Maximum Average Cost Microusd",
            "type": "number"
          },
          "maximum_hallucination_rate": {
            "maximum": 1,
            "minimum": 0,
            "title": "Maximum Hallucination Rate",
            "type": "number"
          },
          "maximum_latency_ms_p95": {
            "exclusiveMinimum": 0,
            "title": "Maximum Latency Ms P95",
            "type": "number"
          },
          "minimum_accuracy": {
            "maximum": 1,
            "minimum": 0,
            "title": "Minimum Accuracy",
            "type": "number"
          },
          "minimum_structured_success_rate": {
            "maximum": 1,
            "minimum": 0,
            "title": "Minimum Structured Success Rate",
            "type": "number"
          },
          "minimum_test_samples": {
            "minimum": 1,
            "title": "Minimum Test Samples",
            "type": "integer"
          }
        },
        "required": [
          "minimum_test_samples",
          "minimum_accuracy",
          "minimum_structured_success_rate",
          "maximum_hallucination_rate",
          "maximum_latency_ms_p95",
          "maximum_average_cost_microusd",
          "approved_by",
          "approval_reference"
        ],
        "title": "Thresholds",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "authorization": {
        "$ref": "#/$defs/Authorization"
      },
      "core_flow_evidence": {
        "$ref": "#/$defs/CoreFlowEvidence"
      },
      "dataset_id": {
        "title": "Dataset Id",
        "type": "string"
      },
      "dataset_version": {
        "title": "Dataset Version",
        "type": "string"
      },
      "samples": {
        "items": {
          "$ref": "#/$defs/EvaluationSample"
        },
        "minItems": 1,
        "title": "Samples",
        "type": "array"
      },
      "schema_version": {
        "const": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "split_policy": {
        "$ref": "#/$defs/SplitPolicy"
      },
      "thresholds": {
        "$ref": "#/$defs/Thresholds"
      }
    },
    "required": [
      "schema_version",
      "dataset_id",
      "dataset_version",
      "authorization",
      "split_policy",
      "thresholds",
      "core_flow_evidence",
      "samples"
    ],
    "title": "EvaluationManifest",
    "type": "object"
  },
  "run": {
    "$defs": {
      "RunObservation": {
        "additionalProperties": false,
        "properties": {
          "cost_microusd": {
            "minimum": 0,
            "title": "Cost Microusd",
            "type": "integer"
          },
          "duration_ms": {
            "minimum": 0,
            "title": "Duration Ms",
            "type": "number"
          },
          "raw_output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Raw Output"
          },
          "sample_id": {
            "title": "Sample Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "success",
              "timeout",
              "provider_error",
              "transport_error",
              "parse_error",
              "skipped"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "sample_id",
          "status",
          "duration_ms",
          "cost_microusd"
        ],
        "title": "RunObservation",
        "type": "object"
      },
      "SystemMetadata": {
        "additionalProperties": false,
        "properties": {
          "adapter_version": {
            "title": "Adapter Version",
            "type": "string"
          },
          "configuration_sha256": {
            "title": "Configuration Sha256",
            "type": "string"
          },
          "data_policy_reference": {
            "minLength": 1,
            "title": "Data Policy Reference",
            "type": "string"
          },
          "execution_mode": {
            "enum": [
              "actual_api",
              "local_baseline"
            ],
            "title": "Execution Mode",
            "type": "string"
          },
          "framework_version": {
            "title": "Framework Version",
            "type": "string"
          },
          "kind": {
            "enum": [
              "baseline_ocr",
              "professional_ocr",
              "public_vlm",
              "custom_vlm"
            ],
            "title": "Kind",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "pricing_reference": {
            "minLength": 1,
            "title": "Pricing Reference",
            "type": "string"
          },
          "prompt_version": {
            "title": "Prompt Version",
            "type": "string"
          },
          "quantization_version": {
            "title": "Quantization Version",
            "type": "string"
          },
          "system_id": {
            "title": "System Id",
            "type": "string"
          }
        },
        "required": [
          "system_id",
          "kind",
          "model_version",
          "framework_version",
          "prompt_version",
          "adapter_version",
          "quantization_version",
          "execution_mode",
          "configuration_sha256",
          "pricing_reference",
          "data_policy_reference"
        ],
        "title": "SystemMetadata",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "dataset_id": {
        "title": "Dataset Id",
        "type": "string"
      },
      "dataset_sha256": {
        "title": "Dataset Sha256",
        "type": "string"
      },
      "observations": {
        "items": {
          "$ref": "#/$defs/RunObservation"
        },
        "minItems": 1,
        "title": "Observations",
        "type": "array"
      },
      "run_id": {
        "title": "Run Id",
        "type": "string"
      },
      "schema_version": {
        "const": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "system": {
        "$ref": "#/$defs/SystemMetadata"
      }
    },
    "required": [
      "schema_version",
      "run_id",
      "dataset_id",
      "dataset_sha256",
      "system",
      "observations"
    ],
    "title": "EvaluationRun",
    "type": "object"
  },
  "schema_version": 1
}
