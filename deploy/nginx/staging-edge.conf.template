log_format smartscan_safe '$remote_addr - $remote_user [$time_local] '
                          '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                          '"$http_user_agent" request_id=$request_id';

map $uri $smartscan_auth_limit_key {
    default "";
    ~^/api/v1/auth/(login|register)$ $binary_remote_addr;
}

limit_req_zone $smartscan_auth_limit_key zone=smartscan_auth:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=smartscan_per_ip:10m;

upstream smartscan_staging {
    server 127.0.0.1:{{UPSTREAM_PORT}};
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{HOST}};
    access_log /var/log/nginx/smartscan-staging-access.log smartscan_safe;
    return 308 https://{{HOST}}$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{HOST}};
    server_tokens off;

    ssl_certificate {{CERTIFICATE}};
    ssl_certificate_key {{CERTIFICATE_KEY}};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SmartScanTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    access_log /var/log/nginx/smartscan-staging-access.log smartscan_safe;
    error_log /var/log/nginx/smartscan-staging-error.log warn;

    client_max_body_size 26m;
    client_body_timeout 120s;
    client_header_timeout 15s;
    keepalive_timeout 65s;
    keepalive_requests 1000;
    sendfile on;
    sendfile_max_chunk 1m;
    tcp_nopush on;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    add_header Strict-Transport-Security "max-age=300" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    limit_conn smartscan_per_ip 20;

    location / {
        limit_req zone=smartscan_auth burst=5 nodelay;
        proxy_pass http://smartscan_staging;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Request-ID $request_id;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_next_upstream off;
    }
}
