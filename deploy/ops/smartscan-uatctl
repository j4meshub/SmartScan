#!/bin/bash
set -euo pipefail

umask 077
IFS=$' \t\n'
export LC_ALL=C
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
readonly PATH

readonly EXECUTOR="/usr/local/libexec/smartscan/smartscan-uatctl"
readonly HELPER="/usr/local/libexec/smartscan/smartscan_uatctl.py"
readonly VALIDATORS="/usr/local/libexec/smartscan/smartscan_uat_validators.py"
readonly CANDIDATE_RELEASE="/usr/local/libexec/smartscan/uat-2026-11-26-worker-fix.json"
readonly EXPECTED_HOSTNAME="ctiecaiserver"
readonly EXPECTED_USER="szhzx"
readonly STAT="/usr/bin/stat"
readonly SHA256="/usr/bin/sha256sum"
readonly PYTHON="/usr/bin/python3"

usage() {
    printf '用法：sudo -n %s {%s}\n' "$EXECUTOR" "status|preflight|verify-storage|verify-models|verify-config|accept-release|import-images|verify-images|probe-identities|apply-ownership|start-database|verify-database|run-migrations|start-core|verify-core|stage-nginx|activate-nginx|verify-uat|stop-core|rollback-images|resume-basic-uat" >&2
}

[[ "$#" -eq 1 ]] || { usage; exit 64; }
case "$1" in
  status|preflight|verify-storage|verify-models|verify-config|accept-release|import-images|verify-images|probe-identities|apply-ownership|start-database|verify-database|run-migrations|start-core|verify-core|stage-nginx|activate-nginx|verify-uat|stop-core|rollback-images|resume-basic-uat) ;;
  *) usage; exit 64 ;;
esac

[[ "$EUID" -eq 0 ]] || { printf 'status=failed\nreason=root_required\n' >&2; exit 1; }
[[ "${SUDO_USER:-}" == "$EXPECTED_USER" ]] || { printf 'status=failed\nreason=sudo_user_mismatch\n' >&2; exit 1; }
[[ "${SUDO_COMMAND:-}" == "$EXECUTOR $1" ]] || { printf 'status=failed\nreason=sudo_command_mismatch\n' >&2; exit 1; }
[[ "$(/usr/bin/hostname -s)" == "$EXPECTED_HOSTNAME" ]] || { printf 'status=failed\nreason=hostname_mismatch\n' >&2; exit 1; }
[[ -f "$EXECUTOR" && ! -L "$EXECUTOR" && "$($STAT -c '%U:%G:%a' "$EXECUTOR")" == 'root:root:755' ]] || { printf 'status=failed\nreason=executor_invalid\n' >&2; exit 1; }
[[ -f "$HELPER" && ! -L "$HELPER" && "$($STAT -c '%U:%G:%a' "$HELPER")" == 'root:root:755' ]] || { printf 'status=failed\nreason=helper_invalid\n' >&2; exit 1; }
[[ -f "$VALIDATORS" && ! -L "$VALIDATORS" && "$($STAT -c '%U:%G:%a' "$VALIDATORS")" == 'root:root:644' ]] || { printf 'status=failed\nreason=validators_invalid\n' >&2; exit 1; }
[[ -f "$CANDIDATE_RELEASE" && ! -L "$CANDIDATE_RELEASE" && "$($STAT -c '%U:%G:%a' "$CANDIDATE_RELEASE")" == 'root:root:644' ]] || { printf 'status=failed\nreason=candidate_release_invalid\n' >&2; exit 1; }

# 本摘要固定到同一审查提交中的辅助工具；任何内容漂移都拒绝运行。
readonly HELPER_SHA256="905514848b2c367e9626fbcd4cb3574e84578d764df61e01034a0d5a0735d21f"
readonly VALIDATORS_SHA256="27916a63ea05c9fb149255b5ee63edc1bd43b1f4e26ec347266eef6026e0467b"
readonly CANDIDATE_RELEASE_SHA256="5ba70365cea255cadb5f5de9cf3c818125c64a30d14b3fc7e659f98924265d73"
[[ "$HELPER_SHA256" != REPLACE_* ]] || { printf 'status=failed\nreason=helper_digest_not_pinned\n' >&2; exit 1; }
[[ "$($SHA256 "$HELPER" | /usr/bin/awk '{print $1}')" == "$HELPER_SHA256" ]] || { printf 'status=failed\nreason=helper_digest_mismatch\n' >&2; exit 1; }
[[ "$VALIDATORS_SHA256" != REPLACE_* ]] || { printf 'status=failed\nreason=validators_digest_not_pinned\n' >&2; exit 1; }
[[ "$($SHA256 "$VALIDATORS" | /usr/bin/awk '{print $1}')" == "$VALIDATORS_SHA256" ]] || { printf 'status=failed\nreason=validators_digest_mismatch\n' >&2; exit 1; }
[[ "$($SHA256 "$CANDIDATE_RELEASE" | /usr/bin/awk '{print $1}')" == "$CANDIDATE_RELEASE_SHA256" ]] || { printf 'status=failed\nreason=candidate_release_digest_mismatch\n' >&2; exit 1; }

exec "$PYTHON" "$HELPER" "$1"
