# 复制到主机 /etc/smartscan/staging/backup.env，权限设为 0600；不得提交真实凭据。
SMARTSCAN_BACKUP_ENVIRONMENT=staging
SMARTSCAN_BACKUP_OFF_HOST_ACK=encrypted-off-host-repository
SMARTSCAN_BACKUP_REPOSITORY_ID=smartscan-staging-primary

# 只允许标准 HTTPS S3/REST 或 SFTP 异机仓库；示例域名必须替换。
RESTIC_REPOSITORY=s3:https://backup.smartscan.example/smartscan-staging
RESTIC_PASSWORD_FILE=/run/secrets/restic_password

# 对象存储凭据仅存在于仓库外的本文件或主机 Secret 管理器中。
AWS_ACCESS_KEY_ID=replace-with-staging-backup-access-key
AWS_SECRET_ACCESS_KEY=replace-with-staging-backup-secret-key

SMARTSCAN_BACKUP_RETENTION_DAILY=7
SMARTSCAN_BACKUP_RETENTION_WEEKLY=4
SMARTSCAN_BACKUP_RPO_HOURS=24
SMARTSCAN_BACKUP_RTO_HOURS=8
