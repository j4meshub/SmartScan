# 复制到主机 /etc/smartscan/staging/runtime.env，权限设为 0600；不得提交真实值。
SMARTSCAN_ENV=production
SMARTSCAN_DATABASE_URL=postgresql+psycopg://smartscan:replace-with-the-same-database-password@postgres:5432/smartscan
SMARTSCAN_AUTO_MIGRATE=false
SMARTSCAN_STORAGE_ROOT=/srv/smartscan/data
SMARTSCAN_INTERNAL_FILE_SEND_PREFIX=/_smartscan_files
SMARTSCAN_SECRET_KEY=replace-with-at-least-32-random-characters
SMARTSCAN_PHONE_HMAC_ACTIVE_KEY_ID=staging-v1
SMARTSCAN_PHONE_HMAC_PEPPERS={"staging-v1":"replace-with-an-independent-random-pepper"}
SMARTSCAN_PHONE_ENCRYPTION_ACTIVE_KEY_ID=phone-staging-v1
SMARTSCAN_PHONE_ENCRYPTION_KEYS={"phone-staging-v1":"replace-with-url-safe-base64-32-byte-key"}
SMARTSCAN_SUPERADMIN_PASSWORD=replace-before-first-staging-start
SMARTSCAN_CORS_ORIGINS=["https://staging.smartscan.example"]
SMARTSCAN_DEV_SMS_CODE=
SMARTSCAN_SMS_MODE=disabled
SMARTSCAN_WECOM_MODE=disabled
SMARTSCAN_WECOM_CORP_ID=
SMARTSCAN_WECOM_AGENT_ID=
SMARTSCAN_WECOM_SECRET=
SMARTSCAN_WECOM_REDIRECT_URI=
SMARTSCAN_OCR_ENABLED=true
SMARTSCAN_OCR_MODEL_ROOT=/opt/smartscan/models/ocr
SMARTSCAN_OCR_PACKAGE_VERSION=3.7.0
SMARTSCAN_OCR_ENGINE_VERSION=3.3.1
SMARTSCAN_OCR_MODEL_VERSION=PP-OCRv6-small-v1
SMARTSCAN_AI_PROVIDERS=[]
SMARTSCAN_QUEUE_HIGH_WATER_JOBS=1000
SMARTSCAN_MAX_ACTIVE_JOBS_PER_USER=2
SMARTSCAN_STORAGE_MIN_FREE_BYTES=53687091200
SMARTSCAN_STORAGE_MIN_FREE_PERCENT=10
SMARTSCAN_USER_STORAGE_QUOTA_BYTES=53687091200
SMARTSCAN_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
SMARTSCAN_WORKER_STALE_SECONDS=45
SMARTSCAN_OPS_METRICS_ENABLED=true
SMARTSCAN_OPS_METRICS_TOKEN=replace-with-an-independent-monitoring-token
